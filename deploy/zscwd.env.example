# ─────────────────────────────────────────────────────────────
# zsc 水电常驻服务配置示例
# 复制为 .env 后修改；.env 已在 .gitignore 中，勿提交。
#   cp .env.example .env && chmod 600 .env
# ─────────────────────────────────────────────────────────────

# 对外 API 令牌（必填，至少 12 字符）：openssl rand -hex 32
# 请求方式：Authorization: Bearer <token>
API_TOKEN=please-change-me-to-a-long-random-token

# HTTP 监听地址。默认只监听回环；暴露到局域网前请自行评估风险。
HTTP_ADDR=0.0.0.0:8080

# 是否允许 ?token=xxx 查询参数（会进日志/浏览器历史，默认关闭）
ALLOW_TOKEN_IN_QUERY=false

# ── 上游水电站点 ──────────────────────────────────────────────
ZSC_BASE_URL=http://znsd.zsc.edu.cn/sdms-pay-weixin
HTTP_TIMEOUT=25s

# ── 定时任务 ──────────────────────────────────────────────────
# 多久主动重新取一次 session（注入一次、开一个网页，然后会被关掉）。
# 真正要的是 JSESSIONID cookie，有效期很长；服务端约 2 分钟是"闲置"超时，
# 但每分钟的请求会持续续期，所以平时不用频繁重取。
SESSION_REFRESH_INTERVAL=30m
# 仅本地保守阈值，必须 >= 2 倍刷新间隔，避免到点多打一次注入。
# 真正失效以业务请求被 302 到微信授权页为准，届时会立即补取。
SESSION_TTL=2h
# 水电数据采集间隔
CHECK_INTERVAL=60s

# ── 微信 / 原生 hook ──────────────────────────────────────────
WECHAT_EXE=/opt/wechat/wechat
APPEX_EXECUTABLE=/opt/wechat/RadiumWMPF/runtime/WeChatAppEx
WECHAT_DISPLAY=:99
WECHAT_HOME=/root

# 微信二进制指纹保护：不匹配直接拒绝注入（留空表示不校验，强烈不建议）
HOOK_EXPECTED_SHA256=2749535f299ba67feb8ef80cab898bb0531fa8f376b16f8a72db706811c84132
HOOK_TIMEOUT=45s
HOOK_SCAN_INTERVAL=1s
# 门控补丁：只挡 state_gate(n==2)，正文不动（见 README「gate 补丁」）。
# 实测开启后点火成功率显著更高，默认 true；如确认不需要可改 false。
HOOK_ENABLE_GATE_PATCH=true

# 取到 session 后等多久关闭本轮打开网页窗口（0 = 不关）。
# 不关会让 AppEx renderer 进程堆积、内存暴涨。
CLOSE_WEBVIEW_DELAY=10s

# ── 登录观测与点火节奏 ────────────────────────────────────────
# 登录态识别间隔。登录是人工扫码事件，调小才能及时捕捉到"刚登录"。
# 每次识别要跑一次 xwd + tesseract，2s 在容器里约 1~3s CPU。
LOGIN_CHECK_INTERVAL=2s
# 确认已登录后，等多久开始第一次点火（给 AppEx 准备时间）。
IGNITE_AFTER_LOGIN=5s

# ── 自动登录 ──────────────────────────────────────────────────
AUTO_LOGIN_ENABLED=true
# 微信进程崩溃/消失时是否自动重启（默认关闭，人工确认后再开）
AUTO_RESTART=true
# 是否允许自动点击（切换二维码登录 / 刷新过期二维码）。默认关闭。
AUTO_CLICK=true
QR_POLL_INTERVAL=5s
# 二维码硬性撤码时间（只用于撤码，不等于扫码有效期）
QR_MAX_AGE=120s
RESTART_COOLDOWN=3m
FAILURE_THRESHOLD=3

LOG_LEVEL=info
